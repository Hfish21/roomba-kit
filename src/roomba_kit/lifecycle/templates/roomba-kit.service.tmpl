# Written by `roomba-kit service install`; remove with `roomba-kit service uninstall`.
[Unit]
Description=Roomba Kit service
Documentation=https://github.com/Hfish21/roomba-kit/blob/main/docs/deployment.md

[Service]
Type=simple
ExecStart=$exec_start
$environment
Restart=on-failure
RestartSec=5
StandardOutput=append:$log
StandardError=append:$log

[Install]
WantedBy=default.target
